# Hostinger / Apache — väldi vanade vahemälude probleeme.
# HTML, CSS ja JS revalideeritakse iga kord (ETag kaudu kiire 304),
# nii et muudatused jõuavad kohale ilma versiooninumbrita URL-is.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Õiged MIME tüübid
AddType text/css .css
AddType application/javascript .js
AddType image/svg+xml .svg
